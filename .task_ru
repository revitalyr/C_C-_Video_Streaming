# 🧠 FFmpeg H264 Encoder (реальный код)

## `media/ffmpeg_h264_encoder.hpp`

```cpp
#pragma once

extern "C" {
#include <libavcodec/avcodec.h>
#include <libavutil/opt.h>
#include <libavutil/imgutils.h>
}

#include "encoder.hpp"

class FFmpegH264Encoder : public IEncoder {
public:
    FFmpegH264Encoder(int width, int height, int fps, int bitrate);
    ~FFmpegH264Encoder();

    std::vector<Frame> encode(const Frame& raw) override;
    std::vector<Frame> flush() override;

private:
    void init();
    void init_frame();

private:
    int width_;
    int height_;
    int fps_;
    int bitrate_;

    AVCodecContext* ctx_{nullptr};
    AVFrame* frame_{nullptr};
    AVPacket* pkt_{nullptr};

    int pts_{0};
};
```

---

## `media/ffmpeg_h264_encoder.cpp`

```cpp
#include "ffmpeg_h264_encoder.hpp"
#include <stdexcept>
#include <cstring>

FFmpegH264Encoder::FFmpegH264Encoder(int w, int h, int fps, int bitrate)
    : width_(w), height_(h), fps_(fps), bitrate_(bitrate) {
    init();
}

FFmpegH264Encoder::~FFmpegH264Encoder() {
    avcodec_free_context(&ctx_);
    av_frame_free(&frame_);
    av_packet_free(&pkt_);
}

void FFmpegH264Encoder::init() {
    const AVCodec* codec = avcodec_find_encoder(AV_CODEC_ID_H264);
    if (!codec) throw std::runtime_error("H264 encoder not found");

    ctx_ = avcodec_alloc_context3(codec);
    if (!ctx_) throw std::runtime_error("Failed to alloc codec context");

    ctx_->width = width_;
    ctx_->height = height_;
    ctx_->time_base = AVRational{1, fps_};
    ctx_->framerate = AVRational{fps_, 1};
    ctx_->pix_fmt = AV_PIX_FMT_YUV420P;
    ctx_->bit_rate = bitrate_;

    // low latency tuning
    av_opt_set(ctx_->priv_data, "preset", "veryfast", 0);
    av_opt_set(ctx_->priv_data, "tune", "zerolatency", 0);

    if (avcodec_open2(ctx_, codec, nullptr) < 0)
        throw std::runtime_error("Failed to open codec");

    frame_ = av_frame_alloc();
    pkt_   = av_packet_alloc();

    init_frame();
}

void FFmpegH264Encoder::init_frame() {
    frame_->format = ctx_->pix_fmt;
    frame_->width  = ctx_->width;
    frame_->height = ctx_->height;

    if (av_frame_get_buffer(frame_, 32) < 0)
        throw std::runtime_error("Failed to alloc frame buffer");
}
```

---

# 🎯 Encode (ключевой кусок)

```cpp
std::vector<Frame> FFmpegH264Encoder::encode(const Frame& raw) {
    std::vector<Frame> out;

    // предполагаем raw.data = YUV420P
    int y_size = width_ * height_;

    std::memcpy(frame_->data[0], raw.data.data(), y_size); // Y
    std::memcpy(frame_->data[1], raw.data.data() + y_size, y_size / 4); // U
    std::memcpy(frame_->data[2], raw.data.data() + y_size + y_size / 4, y_size / 4); // V

    frame_->pts = pts_++;

    if (avcodec_send_frame(ctx_, frame_) < 0)
        return out;

    while (true) {
        int ret = avcodec_receive_packet(ctx_, pkt_);
        if (ret == AVERROR(EAGAIN) || ret == AVERROR_EOF)
            break;

        Frame encoded;
        encoded.timestamp = frame_->pts;
        encoded.data.assign(pkt_->data, pkt_->data + pkt_->size);

        out.push_back(std::move(encoded));

        av_packet_unref(pkt_);
    }

    return out;
}
```

---

# 🧹 Flush

```cpp
std::vector<Frame> FFmpegH264Encoder::flush() {
    std::vector<Frame> out;

    avcodec_send_frame(ctx_, nullptr);

    while (avcodec_receive_packet(ctx_, pkt_) == 0) {
        Frame encoded;
        encoded.data.assign(pkt_->data, pkt_->data + pkt_->size);
        out.push_back(std::move(encoded));

        av_packet_unref(pkt_);
    }

    return out;
}
```

---

# 📡 Встраивание в pipeline

Теперь sender становится:

```cpp
auto encoded_frames = encoder_->encode(frame);

for (auto& f : encoded_frames) {
    auto pkt = packetizer_->packetize(f.data, f.timestamp);
    socket_->send(serialize(pkt), remote_);
}
```

