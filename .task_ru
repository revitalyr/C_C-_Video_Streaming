# ⚙️ Pipeline Model

## `pipeline/stage.hpp`

```cpp
#pragma once
#include <thread>
#include <atomic>

class Stage {
public:
    virtual ~Stage() = default;

    void start() {
        running_ = true;
        thread_ = std::thread([this]{ run(); });
    }

    void stop() {
        running_ = false;
        if (thread_.joinable()) thread_.join();
    }

protected:
    virtual void run() = 0;

    std::atomic<bool> running_{false};
    std::thread thread_;
};
```

---

# 🚀 Sender Pipeline

## `sender/sender_pipeline.cpp`

```cpp
class SenderPipeline {
public:
    void run() {
        while (running_) {
            Frame frame = source_->capture();

            Frame encoded = encoder_->encode(frame);

            auto pkt = packetizer_->packetize(encoded.data, frame.timestamp);

            socket_->send(serialize(pkt), remote_);
        }
    }

private:
    std::unique_ptr<ICameraSource> source_;
    std::unique_ptr<IEncoder> encoder_;
    std::unique_ptr<RtpPacketizer> packetizer_;
    std::unique_ptr<UdpSocket> socket_;
    Endpoint remote_;
};
```

---

# 🖥 Receiver Pipeline

## `receiver/receiver_pipeline.cpp`

```cpp
class ReceiverPipeline {
public:
    void run() {
        while (running_) {
            std::vector<u8> buffer(1500);
            Endpoint sender;

            int len = socket_->recv(buffer, sender);
            if (len <= 0) continue;

            auto pkt = deserialize(buffer);

            jitter_.push(pkt);

            RtpPacket out;
            if (jitter_.pop(out)) {
                auto frame = depacketizer_.process(out);
                auto decoded = decoder_->decode(frame);
                renderer_->render(decoded);
            }
        }
    }

private:
    UdpSocket socket_;
    JitterBuffer jitter_;
};
```

