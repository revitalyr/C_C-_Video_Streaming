# ⚙️ Pipeline Model

## `pipeline/stage.hpp`

```cpp
#pragma once
#include <thread>
#include <atomic>

class Stage {
public:
    virtual ~Stage() = default;

    void start() {
        running_ = true;
        thread_ = std::thread([this]{ run(); });
    }

    void stop() {
        running_ = false;
        if (thread_.joinable()) thread_.join();
    }

protected:
    virtual void run() = 0;

    std::atomic<bool> running_{false};
    std::thread thread_;
};
```

