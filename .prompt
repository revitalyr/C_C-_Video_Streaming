# 📡 RTP Layer

## `rtp/rtp_packet.hpp`

```cpp
#pragma once
#include "common/types.hpp"
#include <vector>

struct RtpHeader {
    u8  version:2{2};
    u8  padding:1{0};
    u8  extension:1{0};
    u8  csrc_count:4{0};
    u8  marker:1{0};
    u8  payload_type:7{96};

    u16 sequence_number{0};
    u32 timestamp{0};
    u32 ssrc{0};
};

struct RtpPacket {
    RtpHeader header;
    std::vector<u8> payload;
};
```

---

## `rtp/rtp_packetizer.hpp`

```cpp
#pragma once
#include "rtp_packet.hpp"

class RtpPacketizer {
public:
    explicit RtpPacketizer(u32 ssrc)
        : ssrc_(ssrc) {}

    RtpPacket packetize(const std::vector<u8>& frame, u32 timestamp);

private:
    u16 sequence_{0};
    u32 ssrc_;
};
```

---

## `rtp/rtp_packetizer.cpp`

```cpp
#include "rtp_packetizer.hpp"

RtpPacket RtpPacketizer::packetize(const std::vector<u8>& frame, u32 ts) {
    RtpPacket pkt;
    pkt.header.sequence_number = sequence_++;
    pkt.header.timestamp = ts;
    pkt.header.ssrc = ssrc_;
    pkt.payload = frame; // TODO: fragmentation for MTU

    return pkt;
}
```

---

# 🧠 Jitter Buffer

## `jitter/jitter_buffer.hpp`

```cpp
#pragma once
#include "rtp/rtp_packet.hpp"
#include <map>

class JitterBuffer {
public:
    void push(const RtpPacket& pkt);

    bool pop(RtpPacket& out);

private:
    std::map<u16, RtpPacket> buffer_;
    u16 expected_seq_{0};
};
```

---

## `jitter/jitter_buffer.cpp`

```cpp
#include "jitter_buffer.hpp"

void JitterBuffer::push(const RtpPacket& pkt) {
    buffer_[pkt.header.sequence_number] = pkt;
}

bool JitterBuffer::pop(RtpPacket& out) {
    auto it = buffer_.find(expected_seq_);
    if (it == buffer_.end())
        return false;

    out = it->second;
    buffer_.erase(it);
    ++expected_seq_;
    return true;
}
```

